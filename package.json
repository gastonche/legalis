{
  "name": "legalis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:agent": "turbo run dev --filter=@legalis/agent",
    "dev:web": "turbo run dev --filter=@legalis/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "ingest": "turbo run ingest --filter=@legalis/ingestion",
    "eval": "turbo run eval --filter=@legalis/evals",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "eval:deep": "pnpm --filter @legalis/evals eval:deep"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@tailwindcss/oxide",
      "sharp",
      "onnxruntime-node",
      "protobufjs"
    ]
  }
}
